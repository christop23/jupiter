# mako config - generated by matugen (templates/mako).
max-history=5
markup=1
actions=1
history=1
default-timeout=5000
sort=+time

# [ BINDING OPTIONS ]
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action

# [ STYLE OPTIONS ]
font= JetBrainsMono Nerd Font 10
background-color={{colors.background.default.hex}}
text-color={{colors.on_background.default.hex}}

width=320
height=240

margin=10
outer-margin=0
padding=16

border-color={{colors.on_primary_container.default.hex}}
border-size=2
border-radius=0

icons=1
max-icon-size=48
icon-location=left

format= <b>%s</b>\n%b
text-alignment=left
max-visible=5
layer=overlay
anchor=top-right

# default-timeout is set once at the top and not repeated here. It was, with the
# same value, and a duplicate key in one group is a trap: the parser takes the
# last, so editing one copy and not the other appears to do nothing.
ignore-timeout=0

[app-name=Volume]
anchor=bottom-center
text-alignment=center
width=200
height=60
border-size=20
border-color={{colors.outline_variant.default.hex}}
background-color={{colors.primary_container.default.hex}}
text-color={{colors.on_background.default.hex}}
progress-color=source {{colors.primary.default.hex}}
outer-margin=0, 0, 30, 0
margin=10
padding=2
layer=overlay
ignore-timeout=1
default-timeout=1000
format=<b>%s</b>

