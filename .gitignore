# Editor and OS droppings. The checkout lives at ~/.dotfiles-jupiter and is
# expected to be edited in place -- install.sh refuses to replace one with
# local changes -- so a stray swap file here shows up as untracked noise in
# every `git status` and trips that prompt for a file nobody made.
*~
*.bak
*.orig
*.rej
*.swp
*.swo
.\#*
\#*\#

# Backup files that install.sh itself writes next to a config it overwrites.
*.jupiter-backup

# Local state a tool may drop inside the tree.
.env
