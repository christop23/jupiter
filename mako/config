border-size=20
border-color=#4a4646
background-color=#564146
text-color=#e8e1e1
progress-color=source #ddbfc5
outer-margin=0, 0, 30, 0
margin=10
padding=2
layer=overlay
ignore-timeout=1
default-timeout=1000
format=<b>%s</b>

