// Startup Applications
spawn-sh-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &"
spawn-at-startup "awww-daemon"
spawn-at-startup "waybar"
spawn-at-startup "sh" "-c" "vicinae server &"

// General Settings
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

output "eDP-1" {
    mode "1920x1080@60.024"
    scale 1
}

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse
    workspace-auto-back-and-forth
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

overview {
    // Rewritten from the matugen accent by theme-sync.sh on every wallpaper
    // change. It used to be a fixed literal, so the overview kept the original
    // theme's backdrop after every wallpaper change, which is the most visible
    // stale colour in the compositor.
    backdrop-color "#1E1E2E"
    workspace-shadow {
        off
    }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

binds {
    // Shortcuts Panel
    MOD+SHIFT+ESCAPE                    { show-hotkey-overlay; }

    // Application Shortcuts
    MOD+RETURN                          hotkey-overlay-title="Open Terminal: alacritty" { spawn-sh "alacritty"; }
    MOD+SHIFT+Q                         hotkey-overlay-title="Lock Screen: gtklock" { spawn-sh "gtklock"; }
    MOD+A                               hotkey-overlay-title="Open App Launcher: vicinae" { spawn-sh "vicinae toggle"; }
    MOD+B                               hotkey-overlay-title="Open Browser: librewolf" { spawn-sh "librewolf"; }
    MOD+E                               hotkey-overlay-title="File Manager: Thunar" { spawn-sh "thunar"; }
    MOD+W                               hotkey-overlay-title="Open Wallpaper Selector" { spawn-sh "$HOME/.config/scripts/bgselector.sh"; }

    // Window Management
    MOD+Q                               { close-window; }

    MOD+H                               { focus-column-left; }
    MOD+J                               { focus-workspace-down; }
    MOD+K                               { focus-workspace-up; }
    MOD+L                               { focus-column-right; }

    MOD+LEFT                            { focus-column-left; }
    MOD+DOWN                            { focus-window-down; }
    MOD+UP                              { focus-window-up; }
    MOD+RIGHT                           { focus-column-right; }

    // Move windows within workspace
    MOD+SHIFT+LEFT                      { move-column-left; }
    MOD+SHIFT+DOWN                      { move-window-down; }
    MOD+SHIFT+UP                        { move-window-up; }
    MOD+SHIFT+RIGHT                     { move-column-right; }

    MOD+SHIFT+H                         { move-column-left; }
    MOD+SHIFT+J                         { move-column-to-workspace-down; }
    MOD+SHIFT+K                         { move-column-to-workspace-up; }
    MOD+SHIFT+L                         { move-column-right; }

    // Move to workspace edges
    MOD+SHIFT+HOME                      { move-column-to-first; }
    MOD+SHIFT+END                       { move-column-to-last; }

    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }

    // Monitor Management - Move between monitors
    MOD+CTRL+LEFT                       { focus-monitor-left; }
    MOD+CTRL+RIGHT                      { focus-monitor-right; }
    MOD+CTRL+UP                         { focus-monitor-up; }
    MOD+CTRL+DOWN                       { focus-monitor-down; }

    MOD+CTRL+H                          { focus-monitor-left; }
    MOD+CTRL+L                          { focus-monitor-right; }
    MOD+CTRL+K                          { focus-monitor-up; }
    MOD+CTRL+J                          { focus-monitor-down; }

    // Move windows to different monitors
    MOD+SHIFT+CTRL+LEFT                 { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT                { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP                   { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN                 { move-column-to-monitor-down; }

    MOD+SHIFT+CTRL+H                    { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+L                    { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+K                    { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+J                    { move-column-to-monitor-down; }

    // Workspace Management
    MOD+ESCAPE                          hotkey-overlay-title="Open Overview" repeat=false { toggle-overview; }
    MOD+WHEELSCROLLDOWN                 cooldown-ms=100 { focus-workspace-down; }
    MOD+WHEELSCROLLUP                   cooldown-ms=100 { focus-workspace-up; }

    // Move windows to different workspaces - using wheel matches K/J pattern
    MOD+SHIFT+WHEELSCROLLDOWN           cooldown-ms=100 { move-column-to-workspace-down; }
    MOD+SHIFT+WHEELSCROLLUP             cooldown-ms=100 { move-column-to-workspace-up; }

    // Column navigation with mouse
    MOD+WHEELSCROLLRIGHT                { focus-column-right; }
    MOD+WHEELSCROLLLEFT                 { focus-column-left; }
    MOD+CTRL+WHEELSCROLLRIGHT           { move-column-right; }
    MOD+CTRL+WHEELSCROLLLEFT            { move-column-left; }

    // Numbered Workspaces
    MOD+1                               { focus-workspace 1; }
    MOD+2                               { focus-workspace 2; }
    MOD+3                               { focus-workspace 3; }
    MOD+4                               { focus-workspace 4; }
    MOD+5                               { focus-workspace 5; }
    MOD+6                               { focus-workspace 6; }
    MOD+7                               { focus-workspace 7; }
    MOD+8                               { focus-workspace 8; }
    MOD+9                               { focus-workspace 9; }

    // Move windows to numbered workspaces with MOD+SHIFT
    MOD+SHIFT+1                         { move-column-to-workspace 1; }
    MOD+SHIFT+2                         { move-column-to-workspace 2; }
    MOD+SHIFT+3                         { move-column-to-workspace 3; }
    MOD+SHIFT+4                         { move-column-to-workspace 4; }
    MOD+SHIFT+5                         { move-column-to-workspace 5; }
    MOD+SHIFT+6                         { move-column-to-workspace 6; }
    MOD+SHIFT+7                         { move-column-to-workspace 7; }
    MOD+SHIFT+8                         { move-column-to-workspace 8; }
    MOD+SHIFT+9                         { move-column-to-workspace 9; }

    MOD+TAB                             { focus-workspace-previous; }

    // Layout Controls
    MOD+C                               { center-column; }
    MOD+CTRL+C                          { center-visible-columns; }
    MOD+BRACKETLEFT                     { set-column-width "-10%"; }
    MOD+BRACKETRIGHT                    { set-column-width "+10%"; }
    MOD+SHIFT+BRACKETLEFT               { set-window-height "-10%"; }
    MOD+SHIFT+BRACKETRIGHT              { set-window-height "+10%"; }

    // Window resizing with mouse
    MOD+CTRL+WHEELSCROLLDOWN            { set-window-height "-5%"; }
    MOD+CTRL+WHEELSCROLLUP              { set-window-height "+5%"; }

    // Window Modes
    MOD+T                               { toggle-window-floating; }
    MOD+F                               { fullscreen-window; }
    MOD+M                               { maximize-column; }
    // MOD+W                               { toggle-column-tabbed-display; }

    // Utils
    MOD+S                               { screenshot; }
    MOD+SHIFT+S                         { screenshot-screen write-to-disk=true; }
    MOD+CTRL+S                          { screenshot-window write-to-disk=true; }

    // Application Restarts
    MOD+ALT+W                           { spawn "sh" "-c" "pgrep -x waybar >/dev/null && killall waybar || waybar &"; }
    // use with toggle in waybar (doens't restart if not running)
    // MOD+ALT+W                           { spawn "killall" "-SIGUSR1" "waybar"; }
}

// Layout Settings
layout {
    gaps 0
    center-focused-column "on-overflow"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // A width of 0 removes the focus indicator entirely, and with
    // focus-follows-mouse below there is then no way to tell which window has
    // focus while navigating by keyboard. active-color is rewritten from the
    // matugen accent on every wallpaper change, so the colour follows the
    // theme; the width is what has to be non-zero for that to be visible.
    focus-ring {
        width 2
        active-color "#1E1E2E"
    }

    // Not off: the colour below is rewritten from the matugen accent on every
    // wallpaper change, and with insert-hint disabled that had nothing to show.
    insert-hint {
        color "#1E1E2E"
    }

    struts {}

}

// Animation Settings
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

// Window Rules
// Application-specific rules
window-rule {
    match app-id=r#"librewolf"# title="^Picture-in-Picture$"
    open-floating true
}

// Open-maximized. A window rule for an application that is never launched is a
// rule that cannot be tested, so this list holds only what is in the package
// list.
window-rule {
    match app-id=r#"librewolf"#
    open-maximized true
}

// File dialogs - Open/Save/Select
//
// `fixed`, not `proportion 0.0`: a proportion is a fraction of the work area,
// so 0.0 is a zero-width column and the dialog is invisible. max-width is only
// a cap, so it does not make up for it.
window-rule {
    match title=r#".*(Open|Save|Select).*"#
    open-floating true
    default-column-width { fixed 800; }
    max-width 800
    max-height 1000
}

// The app-id match is the reliable one. A title of ".*File.*" also matches
// every browser tab with a file:// in it and every editor window with File in
// the title, all of which then float at 800px.
window-rule {
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    match app-id=r#"org\.gtk\.FileChooserNative"#
    open-floating true
    default-column-width { fixed 800; }
    max-width 800
    max-height 1000
}

// LibreWolf's sign-in and account pages, which are otherwise full width.
window-rule {
    match app-id=r#"librewolf"#
    match title=r#".*(Sign in|Google Accounts).*"#
    open-floating true
}

// System dialogs. Anchored to the start of the title rather than matched
// anywhere in it: unanchored, "Settings" floats every settings window on the
// machine, which is most applications' largest window.
window-rule {
    match title=r#"^(Dialog|Properties|Preferences|Settings|Rename)\b.*"#
    open-floating true
}

// Authentication dialogs. The agent this starts is polkit-gnome (see the
// spawn line at the top of this file), so there is no KDE agent to match here;
// the title rule below covers every agent including that one, and the generic
// .*Authentication.* is still useful on its own.
window-rule {
    match title=r#".*Authentication.*"#
    open-floating true
}

// Notification and system utilities
window-rule {
    match app-id=r#"pavucontrol"#
    open-floating true
}

// Steam dialogs
window-rule {
    match app-id=r#"steam"# title=r#".*(Friends|Settings|Properties).*"#
    open-floating true
}

// Global window appearance
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// Inactive window transparency
window-rule {
    match is-active=false
    opacity 0.9
}

// Environment Variables
environment {
    DISPLAY null
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"

    // Wayland Platform Settings
    QT_QPA_PLATFORM "wayland"
    // GTK3 is the platform theme, and it is what the Colloid theme in
    // ~/.themes is written against. A Qt application needs a Qt platform-theme
    // plugin to read it: qt5ct for Qt 5, qt6ct for Qt 6. Both are in
    // PACMAN_PACKAGES in install.sh. Without them this variable names a theme
    // Qt cannot find and it falls back to its own default, so it is set here
    // and the packages are installed rather than the other way round.
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"

    // GTK Settings
    GDK_BACKEND "wayland,x11"

    // LibreWolf Wayland (Gecko-based, same flags as Firefox)
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"

    // SDL Applications
    SDL_VIDEODRIVER "wayland"

    // CLUTTER Applications
    CLUTTER_BACKEND "wayland"

    // VDPAU_DRIVER "va_gl" routes the NVIDIA driver's VDPAU through Mesa's
    // Gallium-based VA frontend, which is what makes it work at all on the
    // proprietary driver. It only does anything on NVIDIA.
    VDPAU_DRIVER "va_gl"

    // LIBVA_DRIVER_NAME is deliberately not set. It named "iHD", which is the
    // Intel driver's name and is therefore wrong on every machine that is not
    // Intel, and it was set unconditionally. The right value is hardware
    // dependent -- iHD for Intel, radeonsi for AMD, NVDEC for NVIDIA -- and
    // none of the three drivers is installed by default here, so naming one
    // gained nothing. The NVIDIA path in install.sh installs libva-utils and
    // vulkan-icd-loader; add intel-media-driver, libva-mesa-driver or
    // mesa-vaapi for the hardware video decode this was reaching for.
}

